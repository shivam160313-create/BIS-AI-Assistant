# Copy this file to .env for local development.
# Never commit the real .env file - it's already in .gitignore.
#
# In FastAPI Cloud, set these as environment variables instead
# (see the "FastAPI Cloud configuration" section of the deployment notes),
# not by uploading a .env file.

# Required: your free Google Gemini API key.
# Get one at https://aistudio.google.com/apikey - no credit card required.
GOOGLE_API_KEY=your-google-api-key-here

# Optional: override the chat model used for all AI endpoints.
# Defaults to gemini-2.5-flash if not set. If the configured model is ever
# unavailable, the app automatically falls back through gemini-2.0-flash,
# gemini-flash-latest, then gemini-1.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional: override the embedding model used to build/search the
# knowledge base. Defaults to gemini-embedding-001 (the current free
# Gemini embedding model; text-embedding-004 was retired 2026-01-14).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: embedding vector size. Gemini Embedding supports elastic
# dimensions (768 / 1536 / 3072). 768 keeps storage small; defaults to 768.
GEMINI_EMBEDDING_DIMENSIONS=768
