# Copy this file to .env for local development.
# Never commit the real .env file - it's already in .gitignore.
#
# In FastAPI Cloud, set these as environment variables instead
# (see the "FastAPI Cloud configuration" section of the deployment notes),
# not by uploading a .env file.

# Required: your OpenAI API key.
OPENAI_API_KEY=sk-your-key-here

# Optional: override the model used for all AI endpoints.
# Defaults to gpt-4o-mini if not set.
OPENAI_MODEL=gpt-4o-mini
